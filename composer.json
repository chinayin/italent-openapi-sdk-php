{
  "name": "chinayin/italent-openapi-sdk",
  "description": "ITalent OpenAPI SDK for PHP - 北森开放平台 SDK",
  "type": "library",
  "license": "Apache-2.0",
  "keywords": [
    "sdk",
    "cloud",
    "italent",
    "library",
    "openapi"
  ],
  "support": {
    "source": "https://github.com/chinayin/italent-openapi-sdk-php",
    "issues": "https://github.com/chinayin/italent-openapi-sdk-php/issues"
  },
  "authors": [
    {
      "name": "chinayin",
      "email": "whereismoney@qq.com"
    }
  ],
  "require": {
    "php": ">=7.4",
    "ext-json": "*",
    "ext-zlib": "*",
    "doctrine/collections": "^1.8 || ^2.0",
    "guzzlehttp/guzzle": "^6.5 || ^7.0",
    "monolog/monolog": "^2.9 || ^3.0",
    "psr/simple-cache": "^1.0 || ^3.0",
    "symfony/cache": "^5.0 || ^7.0",
    "symfony/dependency-injection": "^5.0 || ^7.0",
    "symfony/http-foundation": "^5.0 || ^7.0"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.0",
    "mockery/mockery": "^1.3",
    "phpunit/phpunit": "^9.0",
    "phpstan/phpstan": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "ITalentOpenSDK\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "ITalentOpenSDK\\Tests\\": "tests"
    }
  },
  "config": {
    "sort-packages": true,
    "preferred-install": "dist",
    "optimize-autoloader": true,
    "allow-plugins": {
      "composer/package-versions-deprecated": true
    }
  },
  "scripts": {
    "test": "vendor/bin/phpunit",
    "test-ci": "vendor/bin/phpunit --coverage-text",
    "test-coverage": "vendor/bin/phpunit --coverage-html=runtime/coverage",
    "cs-check": "vendor/bin/php-cs-fixer fix --dry-run --diff -v",
    "cs-fix": "vendor/bin/php-cs-fixer fix -v",
    "phpstan": "vendor/bin/phpstan analyse --memory-limit=-1",
    "phpstan-baseline": "vendor/bin/phpstan analyse --generate-baseline",
    "quality": [
      "@cs-check",
      "@phpstan",
      "@test"
    ],
    "ci": [
      "@cs-check",
      "@phpstan"
    ]
  }
}
